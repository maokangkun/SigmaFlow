#!/bin/sh
# 提交前门禁: ruff 格式 + science 前端回归。
# 有 esbuild 的环境(宿主机)跑完整 science-regression(含重建+dist 一致性);
# 沙箱等无 esbuild 环境只跑测试部分(backend/check/unittest), dist 同步
# 由宿主侧提交完成(见 CLAUDE.md 构建约定)。急事绕过: --no-verify
echo "[pre-commit] ruff format check"
make format-check >/dev/null 2>&1 || {
    echo "[pre-commit] 未过 ruff format —— 运行 'make format' 后重新暂存提交" >&2
    exit 1
}

if git diff --cached --name-only -- src/sigmaflow/server/science | grep -q .; then
    ESB=""
    for c in "$ESBUILD_BIN" node_modules/.bin/esbuild \
             /data/mkk/github/ComfyUI_frontend/node_modules/.bin/esbuild; do
        [ -n "$c" ] && [ -x "$c" ] && ESB="$c" && break
    done
    if [ -n "$ESB" ]; then
        echo "[pre-commit] science 暂存改动: science-regression(含 dist 一致性)"
        ESBUILD_BIN="$ESB" make science-regression >/dev/null 2>&1 || {
            echo "[pre-commit] science-regression 未过 —— 单独跑看详情" >&2
            exit 1
        }
    else
        echo "[pre-commit] science 暂存改动: 测试部分(无 esbuild, dist 门禁留宿主侧同步提交)"
        PY="${PYTHON:-.venv/bin/python}"
        ( cd /data/mkk/github/SigmaFlow 2>/dev/null; "$PY" src/sigmaflow/server/science/tests/test_backend.py >/dev/null 2>&1 \
          && cd src/sigmaflow/server/science && node scripts/check.mjs >/dev/null 2>&1 \
          && node scripts/unittest.mjs >/dev/null 2>&1 ) || {
            echo "[pre-commit] science 测试未过 —— cd src/sigmaflow/server/science && node scripts/check.mjs 看详情" >&2
            exit 1
        }
    fi
fi
